{
  "manifest_version": 3,
  "name": "Caption Mode for YouTube",
  "version": "0.4.0",
  "description": "Read a YouTube video as large captions on a black screen, without leaving the page.",
  "content_scripts": [
    {
      "matches": ["*://www.youtube.com/watch*"],
      "js": ["intent.js", "curtain.js"],
      "css": ["curtain.css"],
      "run_at": "document_start"
    },
    {
      "matches": ["*://www.youtube.com/watch*"],
      "js": [
        "vendor/transcript-classic.js",
        "caption-view.js",
        "overlay.js",
        "glyph.js",
        "content.js"
      ],
      "css": ["content.css", "overlay.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["*://www.youtube.com/*"],
      "js": ["glyph.js", "intent.js", "feed.js"],
      "css": ["feed.css"],
      "run_at": "document_idle",
      "exclude_matches": ["*://www.youtube.com/watch*"]
    }
  ],
  "icons": {
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
